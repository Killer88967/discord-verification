{
  "name": "discord-verification",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "Killer88967",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "concurrently -k --names db,apps \"pnpm db:dev\" \"pnpm dev:apps\"",
    "dev:apps": "wait-on tcp:127.0.0.1:51213 && pnpm --parallel --filter @verification/bot --filter @verification/web dev",
    "dev:web": "pnpm --filter @verification/web dev",
    "dev:bot": "pnpm --filter @verification/bot dev",
    "build": "pnpm -r build",
    "build:nw": "pnpm -r --filter '!@verification/web' build",
    "typecheck": "pnpm -r typecheck",
    "gen:secret": "openssl rand -hex 32",
    "db:gen": "pnpm --filter @verification/database generate",
    "db:build": "pnpm --filter @verification/database build",
    "db:dev": "pnpm --filter @verification/database dev",
    "db:mig": "pnpm --filter @verification/database migrate --name"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "wait-on": "^9.1.0"
  }
}
